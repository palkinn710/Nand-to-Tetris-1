// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not( in=sel , out=c);
    And(a=a , b=c , out=d);
    And(a=sel,b=b,out=w2);
    Or(a=d , b=w2 , out=out);
    //// Replace this comment with your code.
}